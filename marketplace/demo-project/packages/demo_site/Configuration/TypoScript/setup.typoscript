@import 'EXT:demo_site/Configuration/TypoScript/Helper/*.typoscript'

page = PAGE
page {
  typeNum = 0
  meta.description = {$site.description}
  10 = FLUIDTEMPLATE
  10 {
    templateName = Default
    templateRootPaths.10 = EXT:demo_site/Resources/Private/Templates/Page/
    partialRootPaths.10 = EXT:demo_site/Resources/Private/Partials/
    layoutRootPaths.10 = EXT:demo_site/Resources/Private/Layouts/
    variables {
      siteTitle = TEXT
      siteTitle.value = {$site.title}
    }
    dataProcessing.10 = Acme\DemoSite\DataProcessing\TeaserProcessor
    dataProcessing.20 = menu
    dataProcessing.20 {
      levels = 2
      as = mainNavigation
    }
  }
}

[page["doktype"] == 104]
  page.10.templateName = Booking
[END]
